  "item": [
    {
      "name": "1. AUTHENTIFICATION",
      "item": [
        {
          "name": "Inscription Client",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    console.log('Client registration response:', JSON.stringify(jsonData, null, 2));",
                  "    ",
                  "    // Capture user details",
                  "    if (jsonData.user && jsonData.user.id) {",
                              "if (pm.response.code === 200) {",
                              "    var jsonData = pm.response.json();",
                              "    console.log('Seller login successful');",
                              "    // Update tokens",
                              "    if (jsonData.access && typeof jsonData.access === 'string' && jsonData.access.length > 0) {",
                              "        pm.collectionVariables.set('seller_token', jsonData.access);",
                              "        console.log('Seller token set:', jsonData.access);",
                              "    } else {",
                              "        pm.collectionVariables.unset('seller_token');",
                              "        console.log('No seller token found in response!');",
                              "    }",
                              "    // Capture seller profile info if available",
                              "    if (jsonData.user && jsonData.user.seller_profile) {",
                              "        pm.collectionVariables.set('seller_profile_id', jsonData.user.seller_profile.id);",
                              "        console.log('Seller profile ID captured:', jsonData.user.seller_profile.id);",
                              "    }",
                              "} else {",
                              "    pm.collectionVariables.unset('seller_token');",
                              "    console.log('Seller login failed:', pm.response.status, pm.response.text());",
                              "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"johndoe{{$timestamp}}\",\n    \"email\": \"client{{$timestamp}}@test.com\",\n    \"password\": \"Test123!\",\n    \"password_confirm\": \"Test123!\",\n    \"first_name\": \"John\",\n    \"last_name\": \"Doe\",\n    \"role\": \"customer\",\n    \"phone_number\": \"+33612345678\",\n    \"date_of_birth\": \"1990-01-01\",\n    \"address\": \"123 Rue de la Paix, Paris\",\n    \"preferred_language\": \"fr\",\n    \"preferred_currency\": \"EUR\"\n}"
            },
            "url": "{{base_url}}/api/auth/register/"
          }
        },
        {
          "name": "Inscription Vendeur",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    console.log('Seller registration response:', JSON.stringify(jsonData, null, 2));",
                  "    ",
                  "    // Capture seller details",
                  "    if (jsonData.user && jsonData.user.id) {",
                  "        pm.collectionVariables.set('seller_id', jsonData.user.id);",
                  "        pm.collectionVariables.set('seller_username', jsonData.user.username);",
                  "        console.log('Seller ID captured:', jsonData.user.id);",
                  "        console.log('Seller username captured:', jsonData.user.username);",
                  "        ",
                  "        // Capture seller profile if available",
                  "        if (jsonData.user.seller_profile) {",
                  "            pm.collectionVariables.set('seller_profile_id', jsonData.user.seller_profile.id);",
                  "            console.log('Seller profile ID captured:', jsonData.user.seller_profile.id);",
                  "        }",
                  "    }",
                  "    ",
                  "    // Capture tokens",
                  "    if (jsonData.access) {",
                  "        pm.collectionVariables.set('seller_token', jsonData.access);",
                  "        console.log('Seller token captured');",
                  "    }",
                  "} else {",
                  "    console.log('Seller registration failed:', pm.response.status, pm.response.text());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"seller{{$timestamp}}\",\n    \"email\": \"seller{{$timestamp}}@test.com\",\n    \"password\": \"Test123!\",\n    \"password_confirm\": \"Test123!\",\n    \"first_name\": \"Marie\",\n    \"last_name\": \"Seller\",\n    \"phone_number\": \"+33612345679\",\n    \"shop_name\": \"Ma Boutique {{$timestamp}}\",\n    \"shop_description\": \"Boutique spécialisée en électronique\",\n    \"business_type\": \"individual\",\n    \"country\": \"France\"\n}"
            },
            "url": "{{base_url}}/api/auth/register/seller/"
          }
        },
        {
          "name": "Login Client",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    console.log('Client login successful');",
                  "    ",
                  "    // Update tokens",
                  "    if (jsonData.access) {",
                  "        pm.collectionVariables.set('client_token', jsonData.access);",
                  "        console.log('Client token refreshed');",
                  "    }",
                  "    ",
                  "    if (jsonData.refresh) {",
                  "        pm.collectionVariables.set('refresh_token', jsonData.refresh);",
                  "        console.log('Refresh token updated');",
                  "    }",
                  "    ",
                  "    // Capture user info if available",
                  "    if (jsonData.user) {",
                  "        if (jsonData.user.id) {",
                  "            pm.collectionVariables.set('user_id', jsonData.user.id);",
                  "        }",
                  "        if (jsonData.user.customer_profile) {",
                  "            pm.collectionVariables.set('customer_profile_id', jsonData.user.customer_profile.id);",
                  "        }",
                  "    }",
                  "} else {",
                  "    console.log('Client login failed:', pm.response.status, pm.response.text());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"{{client_username}}\",\n    \"password\": \"Test123!\"\n}"
            },
            "url": "{{base_url}}/api/auth/login/"
          }
        },
        {
          "name": "Login Vendeur",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    console.log('Seller login successful');",
                  "    ",
                  "    // Update tokens",
                  "    if (jsonData.access) {",
                  "        pm.collectionVariables.set('seller_token', jsonData.access);",
                  "        console.log('Seller token refreshed');",
                  "    }",
                  "    ",
                  "    // Capture seller profile info if available",
                  "    if (jsonData.user && jsonData.user.seller_profile) {",
                  "        pm.collectionVariables.set('seller_profile_id', jsonData.user.seller_profile.id);",
                  "        console.log('Seller profile ID captured:', jsonData.user.seller_profile.id);",
                  "    }",
                  "} else {",
                  "    console.log('Seller login failed:', pm.response.status, pm.response.text());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"{{seller_username}}\",\n    \"password\": \"Test123!\"\n}"
            },
            "url": "{{base_url}}/api/auth/login/"
          }
        },
        {
          "name": "Profil Utilisateur (Me)",
            "event": [
              {
                "listen": "prerequest",
                "script": {
                  "exec": [
                    "// Always set Authorization header dynamically with latest client_token",
                    "if (pm.collectionVariables.get('client_token')) {",
                    "    pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + pm.collectionVariables.get('client_token') });",
                    "}"
                  ]
                }
              }
            ],
            "request": {
              "method": "GET",
              "header": [
                {
                  "key": "Authorization",
                  "value": "Bearer {{client_token}}"
                }
              ],
              "url": "{{base_url}}/api/auth/me/"
            }
        }
      ]
